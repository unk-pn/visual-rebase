{
  "name": "visual-rebase",
  "publisher": "unk",
  "displayName": "Visual Rebase",
  "description": "Simplify interactive git rebase with an easy-to-use visual editor",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": "https://github.com/unk-pn/visual-rebase",
  "license": "MIT",
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Visual Rebase",
      "properties": {
        "visualRebase.editor": {
          "type": "string",
          "enum": ["auto", "code", "codium", "cursor", "custom"],
          "enumDescriptions": [
            "Automatically detect current editor (VS Code, VSCodium, Cursor)",
            "Visual Studio Code (code)",
            "VSCodium (codium)",
            "Cursor (cursor)",
            "Custom command (specified below)"
          ],
          "default": "auto",
          "description": "Editor to use for git rebase in the integrated terminal"
        },
        "visualRebase.customEditorCommand": {
          "type": "string",
          "default": "",
          "description": "Custom editor command (when 'custom' is selected, e.g. 'agy' or a binary path)"
        },
        "visualRebase.defaultAction": {
          "type": "string",
          "enum": ["squash", "fixup", "reword", "edit", "drop", "pick"],
          "enumDescriptions": [
            "SQUASH — combine commit into previous commit and combine messages",
            "REWORD — keep commit and edit commit message",
            "EDIT — stop for amending",
            "FIXUP — combine commit into previous commit and discard message",
            "DROP — remove commit",
            "PICK — keep commit as is"
          ],
          "default": "squash",
          "description": "Default action selected in the dropdown list"
        }
      }
    }
  },
  "scripts": {
    "build-vsce": "vsce package --no-yarn",
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@secretlint/secretlint-formatter-sarif": "^11.5.0",
    "@secretlint/secretlint-rule-no-dotenv": "^11.5.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.4.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
